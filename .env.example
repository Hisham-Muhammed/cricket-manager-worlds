# Copy to .env or set in your hosting provider (Render / Railway / VPS)
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database: Supabase is the PRODUCTION backend ---------------------------
# DATABASE_MODE=supabase  -> use Supabase (Postgres + Auth) in production.
#   Migration step 1 is live: register/login/Google run on Supabase Auth
#   with profiles in public.managers. Remaining routes still use the
#   local store until their migration steps land (see WORKLOG.md).
# DATABASE_MODE=local     -> local-dev fallback only: JSON file store below
DATABASE_MODE=local
DATABASE=./data/db.json
# From Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# SECRET — server only. Never commit a real value, never put it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — in production (DATABASE_MODE=supabase) the credentials
# live in Supabase Auth -> Providers -> Google and these three are NOT
# used by the server. In local mode they power the built-in direct
# /api/auth/google flow.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Scheduler tick in milliseconds (default 10000)
SCHEDULER_INTERVAL_MS=10000
