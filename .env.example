# Copy to .env or set in your hosting provider (Render / Railway / VPS)
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin of the deployed site (scheme + host, no trailing
# slash). The server uses it to build every URL that leaves the server
# — the Supabase OAuth redirect_to and the default Google callback —
# so they are https in production. (Without it the origin is derived
# from the request; behind a TLS-terminating proxy that used to come
# out as http:// and broke Google sign-in.)
# Production value: https://cricket-manager-worlds.onrender.com
PUBLIC_URL=

# --- Database: Supabase is the PRODUCTION backend ---------------------------
# DATABASE_MODE=supabase  -> use Supabase (Postgres + Auth) in production.
#   Migration step 1 is live: register/login/Google run on Supabase Auth
#   with profiles in public.managers. The FULL game state (worlds,
#   memberships, auctions, bids, fixtures…) also persists in Supabase:
#   the server mirrors it to the single-row public.app_state table on
#   every save and loads it on boot, so restarts/redeploys never wipe
#   worlds. That needs SUPABASE_SERVICE_ROLE_KEY in the server env
#   (below) and the one-time app_state SQL from supabase/schema.sql run
#   once in the Supabase SQL Editor. A normalised per-table migration
#   (worlds/auctions as rows) remains future work — see WORKLOG.md.
# DATABASE_MODE=local     -> local-dev fallback only: JSON file store below
DATABASE_MODE=local
DATABASE=./data/db.json
# From Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# SECRET — server only. Never commit a real value, never put it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — in production (DATABASE_MODE=supabase) the credentials
# live in Supabase Auth -> Providers -> Google and these three are NOT
# used by the server. In local mode they power the built-in direct
# /api/auth/google flow.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
# GOOGLE_CALLBACK_URL is optional when PUBLIC_URL is set — it then
# defaults to <PUBLIC_URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Scheduler tick in milliseconds (default 10000)
SCHEDULER_INTERVAL_MS=10000
